# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Command-line client for the University of Tsukuba TWINS"
description: "An unofficial OCaml client for TWINS/CAMPUSSQUARE."
maintainer: ["Kyure-A"]
authors: ["Kyure-A"]
license: "GPL-3.0-only"
homepage: "https://github.com/Kyure-A/twins-cli"
bug-reports: "https://github.com/Kyure-A/twins-cli/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.12"}
  "cmdliner"
  "cohttp-lwt-unix"
  "alcotest" {with-test}
  "lambdasoup"
  "lwt"
  "uri"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Kyure-A/twins-cli.git"
